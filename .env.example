OPENROUTER_API_KEY=sk-or-...
# Model used by the question/stats/image/report agents. Any OpenRouter id.
OPENROUTER_MODEL=openai/gpt-5-mini

JEV_PROVIDER=openrouter
# openrouter: typesafe/jev-latest | typesafe/jev-1.13
# typesafe:   jev-latest | jev-1.13
JEV_MODEL=typesafe/jev-latest
# Only needed when JEV_PROVIDER=typesafe
# TYPESAFE_AI_API_KEY=
# Probability at which Jev's "coverage is sufficient" answer stops recursion early
# JEV_EARLY_STOP_THRESHOLD=0.8
# Probability at which Jev flags a follow-up question as a duplicate
# JEV_DUPLICATE_THRESHOLD=0.6


TAVILY_API_KEY=tvly-...
EXA_API_KEY=


# RECURSEARCH_DEFAULT_DEPTH=3
# RECURSEARCH_MAX_DEPTH=6
# Layers completed before Jev may stop early
# RECURSEARCH_MIN_DEPTH=2
